<?xml version="1.0" encoding="windows-1251"?>
<!--
    The Artefact Almanac's page in the PDA: the groups as tabs across the top, then the artifacts
    of one beside the entry of one, in the free content box every PDA page uses, (28,106)-(792,709)
    of the 1024x768 PDA frame. Colors: heading 238,196,112; body 200,200,200; dim 140,140,140
    (almanac_page roles, ui_almanac's ROLES).
-->
<w>
	<!-- the flat window (the MCM key): the 2D PDA's frame and caption, where pda_16.xml puts them
	     relative to the PDA's pages -->
	<flat_bezel x="-10" y="-34" width="819" height="768" stretch="1">
		<texture>ui_inGame2_pda_texture</texture>
	</flat_bezel>
	<flat_caption x="29" y="28" width="748" height="17">
		<text font="letterica16" align="l" r="170" g="170" b="170">st_almanac_title</text>
	</flat_caption>

	<!-- header: how many are known, and Back to Mod App Creator's launcher while the page has
	     its tile -->
	<known_count x="32" y="110" width="400" height="20">
		<text font="letterica16" r="200" g="200" b="200" align="l" vert_align="c"/>
	</known_count>
	<btn_back x="672" y="107" width="120" height="26" stretch="1" check_mode="0">
		<texture>ui_button_ordinary</texture>
		<text font="letterica16" align="c" vert_align="c">st_almanac_back</text>
	</btn_back>
	<rule_top x="28" y="139" width="764" height="1" stretch="1">
		<texture r="90" g="90" b="90">almanac_px</texture>
	</rule_top>

	<!-- the groups as tabs across the page, as many as there are, side by side with a gap: each a
	     panel, a mark (almanac_marks: the crystal for all, a stone for junk, GRIP's chevrons for
	     the tiers) and how many are known of how many; the chosen one lit and underlined. The
	     page sizes the panels (ui_almanac's TAB_LIGHT lights one under the cursor); a tab's
	     button draws nothing, since a 3t button's texture keeps its XML size. tab_row is only read
	     for its place -->
	<tab_row x="28" y="145" width="764" height="32"/>
	<tab_bg x="0" y="0" width="100" height="32" stretch="1">
		<texture>almanac_px</texture>
	</tab_bg>
	<tab_on x="0" y="0" width="100" height="32" stretch="1">
		<texture r="255" g="255" b="255" a="30">almanac_px</texture>
	</tab_on>
	<tab_line x="0" y="30" width="100" height="2" stretch="1">
		<texture r="238" g="196" b="112">almanac_px</texture>
	</tab_line>
	<tab x="0" y="0" width="100" height="32" stretch="1" check_mode="0">
		<texture>almanac_tab</texture>
	</tab>
	<tab_mark x="0" y="3" width="26" height="26" stretch="1"/>
	<tab_count x="0" y="0" width="60" height="32">
		<text font="letterica16" r="200" g="200" b="200" align="l" vert_align="c"/>
	</tab_count>
	<rule_tabs x="28" y="181" width="764" height="1" stretch="1">
		<texture r="90" g="90" b="90">almanac_px</texture>
	</rule_tabs>

	<!-- columns: the chosen group's name and count over its artifacts, and the entry -->
	<list_caption x="32" y="186" width="276" height="22">
		<text font="letterica18" r="238" g="196" b="112" align="l" vert_align="c"/>
	</list_caption>
	<art_list x="28" y="210" width="282" height="468" item_height="22" can_select="1" always_show_scroll="0">
		<font font="letterica16" r="200" g="200" b="200"/>
	</art_list>
	<rule_art x="316" y="186" width="1" height="492" stretch="1">
		<texture r="90" g="90" b="90">almanac_px</texture>
	</rule_art>
	<detail x="324" y="186" width="468" height="492" always_show_scroll="0" stretch="1"/>

	<!-- list rows: 22 high, as the Guide's -->
	<art_name x="4" y="0" width="272" height="22">
		<text font="letterica16" r="200" g="200" b="200" align="l" vert_align="c"/>
	</art_name>

	<!-- the entry, built per artifact inside the detail scroll view; 452 wide leaves room for its bar -->
	<entry x="0" y="0" width="452" height="560" stretch="1"/>
	<!-- a panel a little lighter than the PDA behind the icon, like the inventory's grid -->
	<entry_icon_bg x="0" y="2" width="452" height="96" stretch="1">
		<texture r="160" g="160" b="160" a="90">almanac_px</texture>
	</entry_icon_bg>
	<entry_icon_frame x="8" y="8" width="436" height="84" stretch="1"/>
	<entry_icon x="0" y="0" width="10" height="10" stretch="1"/>
	<!-- see-through: a stat card label measured as the inventory's row lays it out (utils.xml
	     stats_box cap: 125 wide, 100 in utils_16.xml, which ui_almanac sets on a widescreen;
	     letterica16, wrapping) -->
	<entry_card_cap x="21" y="0" width="125" height="8">
		<text complex_mode="1" font="letterica16" align="l"/>
	</entry_card_cap>
	<entry_name x="0" y="104" width="452" height="20">
		<text font="letterica18" r="238" g="196" b="112" align="l" vert_align="t" complex_mode="1"/>
	</entry_name>
	<entry_rule x="0" y="0" width="452" height="1" stretch="1">
		<texture r="90" g="90" b="90">almanac_px</texture>
	</entry_rule>
	<entry_heading x="0" y="0" width="452" height="20">
		<text font="letterica18" r="238" g="196" b="112" align="l" vert_align="c"/>
	</entry_heading>
	<!-- a link line's button: clear, only for the click (ui_almanac sizes it to the line) -->
	<entry_link x="0" y="0" width="452" height="18" stretch="1" check_mode="0">
		<texture>almanac_tab</texture>
	</entry_link>
	<entry_line x="0" y="0" width="452" height="18">
		<text font="letterica16" r="200" g="200" b="200" align="l" vert_align="t" complex_mode="1"/>
	</entry_line>

	<!-- footer: the jailbreak line while MCM shows everything, and the app and its version -->
	<rule_foot x="28" y="681" width="764" height="1" stretch="1">
		<texture r="90" g="90" b="90">almanac_px</texture>
	</rule_foot>
	<jailbreak_lbl x="32" y="686" width="300" height="20">
		<text font="letterica16" r="238" g="155" b="23" align="l" vert_align="c">st_almanac_jailbreak_on</text>
	</jailbreak_lbl>
	<credit x="460" y="686" width="328" height="20">
		<text font="letterica16" r="140" g="140" b="140" align="r" vert_align="c"/>
	</credit>
</w>
