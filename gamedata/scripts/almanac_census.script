--[[
Artefact Almanac: the in-game census.

Once after each load (each level arrival is one) and once after each emission and psi storm, it
counts every artifact the alife holds, level by level: the ones lying free, by section, with who
spawned them (a field or Dynamic Anomalies) and how long ago Artefacts Reinvention's despawner
first saw them, and the ones someone owns (the player, a stalker, a box, a mutant). It also lists
the levels due their post-emission roll. It only reads. Each census is one JSON line in
$app_data_root$\almanac_census.jsonl and a summary line in the game's log.

The waits let the arrival's rolls and the despawner run first: the fields roll at the first
update, Dynamic Anomalies on arrival, and an emission's field roll right as it ends.
--]]

VERSION = "1.0.0"
FILE = "almanac_census.jsonl"

AFTER_LOAD_MS = 45000       -- the wait after a load before its census
AFTER_STORM_MS = 30000      -- the wait after an emission or psi storm ends
MAX_ID = 65534

local KINDS = { i_arty = true, i_arty_junk = true }

local level_by_gv = {}

-- the level a server object stands on, by its game vertex
function level_of(se)
    local gv = se.m_game_vertex_id
    if gv == nil then
        return "?"
    end
    local name = level_by_gv[gv]
    if name == nil then
        local ok, n = pcall(function() return alife():level_name(game_graph():vertex(gv):level_id()) end)
        name = ok and n or "?"
        level_by_gv[gv] = name
    end
    return name
end

local function add(t, k, n)
    t[k] = (t[k] or 0) + (n or 1)
end

-- who holds an artifact: nil when it lies free, else "actor", "stalker", "box", "monster" or
-- "other" (the despawner's own test for an owned one)
function owner_of(sim, se)
    local pid = se.parent_id
    if pid == nil or pid >= 65535 then
        return nil
    end
    if pid == AC_ID then
        return "actor"
    end
    local p = sim:object(pid)
    if not p then
        return "other"
    end
    if IsStalker(p) then
        return "stalker"
    end
    if IsInvbox(p) then
        return "box"
    end
    if IsMonster(p) then
        return "monster"
    end
    return "other"
end

-- the artifacts Dynamic Anomalies spawned and still tracks, by id
local function dao_ids()
    local ids = {}
    local levels = drx_da_main and drx_da_main.updated_anomaly_levels
    if type(levels) == "table" then
        for _, l in pairs(levels) do
            if type(l) == "table" and type(l.artefacts) == "table" then
                for id in pairs(l.artefacts) do
                    ids[id] = true
                end
            end
        end
    end
    return ids
end

-- the despawner's age bucket for an artifact: when it first saw it lying free (it looks on each
-- arrival, and releases one after 5 game days)
function age_of(id, now)
    local seen = grok_artefact_despawner and grok_artefact_despawner.artefacts_spawned_time
    local t = type(seen) == "table" and seen[id]
    if not t then
        return "unseen"
    end
    local ok, sec = pcall(function() return now:diffSec(grok_artefact_despawner.t2c(t)) end)
    if not ok or type(sec) ~= "number" then
        return "unseen"
    end
    local days = sec / 86400
    if days < 1 then
        return "under 1 day"
    elseif days < 3 then
        return "1-3 days"
    elseif days < 5 then
        return "3-5 days"
    end
    return "5 days or more"
end

local function level_entry(c, name)
    local e = c.levels[name]
    if not e then
        e = { free = 0, sections = {}, by = {}, ages = {}, owned = {} }
        c.levels[name] = e
    end
    return e
end

function game_date()
    local Y, M, D, h, m = game.get_game_time():get(0, 0, 0, 0, 0, 0, 0)
    return string.format("%04d-%02d-%02d %02d:%02d", Y, M, D, h, m)
end

-- one census of the alife; nothing in it is changed
function take(cause)
    local t0 = os.clock()
    local sim = alife()
    local now = game.get_game_time()
    local c = { v = 1, version = VERSION, cause = cause, date = game_date(), levels = {}, due = {},
                kinds = {} }
    c.level = level and level.name and level.name() or "?"
    -- the real time, so a test session's lines can be told from play by when it ran
    c.real = os.date("%Y-%m-%d %H:%M:%S")
    local dao = dao_ids()
    local fields = bind_anomaly_zone and bind_anomaly_zone.parent_zones_by_artefact_id or {}
    for id = 1, MAX_ID do
        local se = sim:object(id)
        if se and IsArtefact(se) then
            local sec = se:section_name()
            local kind = SYS_GetParam(0, sec, "kind", "")
            if KINDS[kind] then
                add(c.kinds, kind)
                local e = level_entry(c, level_of(se))
                local who = owner_of(sim, se)
                if who then
                    add(e.owned, who)
                else
                    e.free = e.free + 1
                    add(e.sections, sec)
                    add(e.by, dao[id] and "dao" or fields[id] and "field" or "other")
                    add(e.ages, age_of(id, now))
                end
            end
        end
    end
    local m_data = alife_storage_manager and alife_storage_manager.get_state()
    local due = m_data and m_data.artefact_respawn_levels
    if type(due) == "table" then
        for name, yes in pairs(due) do
            if yes then
                c.due[#c.due + 1] = name
            end
        end
    end
    table.sort(c.due)
    c.ms = math.floor((os.clock() - t0) * 10000 + 0.5) / 10
    return c
end

-- JSON, with object keys sorted so that two censuses of one world read the same
local function escape(s)
    return (s:gsub('[%c"\\]', function(ch)
        if ch == '"' then return '\\"' end
        if ch == "\\" then return "\\\\" end
        return string.format("\\u%04x", ch:byte())
    end))
end

function to_json(v)
    local ty = type(v)
    if ty == "table" then
        if v[1] ~= nil then
            local out = {}
            for i = 1, #v do
                out[i] = to_json(v[i])
            end
            return "[" .. table.concat(out, ",") .. "]"
        end
        local keys = {}
        for k in pairs(v) do
            keys[#keys + 1] = tostring(k)
        end
        table.sort(keys)
        local out = {}
        for i, k in ipairs(keys) do
            out[i] = '"' .. escape(k) .. '":' .. to_json(v[k])
        end
        return "{" .. table.concat(out, ",") .. "}"
    elseif ty == "number" then
        if v ~= v or v == math.huge or v == -math.huge then
            return "null"
        end
        if v == math.floor(v) and math.abs(v) < 2 ^ 53 then
            return string.format("%d", v)
        end
        return string.format("%.6g", v)
    elseif ty == "string" then
        return '"' .. escape(v) .. '"'
    elseif ty == "boolean" then
        return tostring(v)
    end
    return "null"
end

function path()
    return getFS():update_path("$app_data_root$", FILE)
end

function summary(c)
    local here = c.levels[c.level]
    local free, elsewhere, owned = here and here.free or 0, 0, 0
    for name, e in pairs(c.levels) do
        if name ~= c.level then
            elsewhere = elsewhere + e.free
        end
        for _, n in pairs(e.owned) do
            owned = owned + n
        end
    end
    return string.format("%s (%s) on %s: %s free here, %s free elsewhere, %s owned, %s levels due, %s ms",
        c.date, c.cause, c.level, free, elsewhere, owned, #c.due, c.ms)
end

-- take a census and write it; nothing it meets can break the game's update
function run(cause)
    local ok, err = pcall(function()
        local c = take(cause)
        local ok2, err2 = pcall(function()
            local f = assert(io.open(path(), "a"))
            f:write(to_json(c), "\n")
            f:close()
        end)
        if not ok2 then
            printf("! [almanac-census] the log: %s", tostring(err2))
        end
        printf("[almanac-census] %s", summary(c))
    end)
    if not ok then
        printf("! [almanac-census] %s", tostring(err))
    end
    return ok
end

-- the censuses waiting to run: { at = time_global ms, cause = string }
local pending = {}

function queue(cause, wait)
    pending[#pending + 1] = { at = time_global() + wait, cause = cause }
end

local function actor_on_first_update()
    queue("load", AFTER_LOAD_MS)
end

local function actor_on_interaction(typ, obj, name)
    if typ ~= "anomalies" then
        return
    end
    if name == "emission_end" then
        queue("emission", AFTER_STORM_MS)
    elseif name == "psi_storm_end" then
        queue("psi storm", AFTER_STORM_MS)
    end
end

local function actor_on_update()
    if #pending == 0 then
        return
    end
    local now = time_global()
    local i = 1
    while i <= #pending do
        local p = pending[i]
        if now >= p.at then
            table.remove(pending, i)
            run(p.cause)
        else
            i = i + 1
        end
    end
end

function on_game_start()
    RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
    RegisterScriptCallback("actor_on_interaction", actor_on_interaction)
    RegisterScriptCallback("actor_on_update", actor_on_update)
end
