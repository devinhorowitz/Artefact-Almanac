--[[
Artefact Almanac: learning of an artifact without holding one. Each is kept by almanac_found.learn,
once, with when, from whom and where, and only while the artifact isn't found.

- The radio: when a stalker picks an artifact up, the game may put "found an artifact" news on his
  faction's channel (dynamic_news_manager:FoundArtefact, from xr_gather_items). The news is queued
  and reaches the player later, or never (a PDA out of charge, the channels quiet after a storm).
  So the artifact is learned only when that message is sent to the player: FoundArtefact is
  wrapped to note the queued message's text, and dynamic_news_helper.send_tip to catch it going
  out. The place is where the stalker stood.
- Tasks: a fetch task keeps what it asks for in the actor's var "<task id>_fetch". Every few seconds,
  and at each load, the tasks the player has are read, and an artifact one asks for is learned,
  from the task's giver.
- A looted PDA (a corpse's, as ui_pda_npc_tab registered its owner): its owner's notes on as many
  artifacts as its size (common 1, uncommon 2, rare 3), once per PDA and owner; an encrypted one
  when a technician has decrypted it. As Arsenal's intel reads PDAs.
- An Ecologist's talk (a dialog modxml_almanac adds to every character, which only a living
  Ecologist who isn't hostile offers): word of one artifact, once a day each.
Both tell of artifacts the player doesn't know yet that turn up somewhere, those the Zone makes on
the level the player is on first.

Both wrappers pass every argument through and give back every result, and stand aside when the
script they wrap is missing.
--]]

VERSION = "0.1.0"

CHECK_MS = 5000         -- how often the tasks are read
MAX_PENDING = 64        -- queued radio messages remembered at most
-- a corpse's PDA and how many artifacts its notes tell of
PDA_SIZE = { itm_pda_common = 1, itm_pda_uncommon = 2, itm_pda_rare = 3 }
local READ, TALKED = "almanac_read", "almanac_talked"     -- the marks on a PDA and an Ecologist

local pending, n_pending = {}, 0     -- a queued message's text -> { sec, who, place }
local wrapped_news, wrapped_tip = false, false
local next_check
local first_read = true             -- the read after a load is quiet

local function log(fmt, ...)
    printf("[almanac-learn] " .. fmt, ...)
end

-- the radio's "found an artifact" news, once queued: its text, to catch when it's sent
local function note(dnm, sender, itm)
    local sec = itm and almanac_found.artifact_of(itm:section())
    if not sec then
        return
    end
    local q = dnm.queue and dnm.queue[sender:character_community()]
    local e = q and q[1]
    -- the news names its sender by his object, or by his id once dEmergence's news fixes have
    -- swapped it in
    if not (type(e) == "table" and e.Ty == "artifact" and (e.Id == sender or e.Id == sender:id()) and type(e.Mg) == "string") then
        return
    end
    if n_pending >= MAX_PENDING then
        pending, n_pending = {}, 0
    end
    if not pending[e.Mg] then
        n_pending = n_pending + 1
    end
    pending[e.Mg] = { sec = sec, who = sender:character_name(), place = almanac_found.place_of(sender) }
end

function wrap_news()
    local C = dynamic_news_manager and dynamic_news_manager.DynamicNewsManager
    if wrapped_news or not (C and type(C.FoundArtefact) == "function") then
        return wrapped_news
    end
    local orig = C.FoundArtefact
    C.FoundArtefact = function(self, sender, itm, ...)
        local res = { orig(self, sender, itm, ...) }
        if res[1] == true then
            local ok, err = pcall(note, self, sender, itm)
            if not ok then
                log("! the radio: %s", tostring(err))
            end
        end
        return unpack(res)
    end
    wrapped_news = true
    return true
end

function wrap_tip()
    local H = dynamic_news_helper
    if wrapped_tip or not (H and type(H.send_tip) == "function") then
        return wrapped_tip
    end
    local orig = H.send_tip
    H.send_tip = function(msg, ...)
        local p = type(msg) == "string" and pending[msg] or nil
        local res = { orig(msg, ...) }
        if p then
            pending[msg] = nil
            n_pending = n_pending - 1
            if res[1] ~= false then
                local ok, err = pcall(almanac_found.learn, p.sec, { kind = "news", who = p.who, place = p.place })
                if not ok then
                    log("! the radio: %s", tostring(err))
                end
            end
        end
        return unpack(res)
    end
    wrapped_tip = true
    return true
end

-- a task giver's name, or nil
local function giver_name(id)
    if not id then
        return nil
    end
    local ok, name = pcall(function()
        local o = level.object_by_id(id)
        if o then
            return o:character_name()
        end
        local se = alife():object(id)
        return se and se:character_name()
    end)
    return ok and name or nil
end

-- the artifacts the player's tasks ask for, learned from their givers; quietly for the tasks
-- already there at a load
function read_tasks(quiet)
    local tm = task_manager and task_manager.get_task_manager and task_manager.get_task_manager()
    local info = tm and tm.task_info
    if type(info) ~= "table" or not db.actor then
        return 0
    end
    local n = 0
    for task_id, t in pairs(info) do
        local sec = load_var(db.actor, task_id .. "_fetch")
        local a = type(sec) == "string" and almanac_found.artifact_of(sec)
        if a and almanac_found.learn(a, { kind = "task", who = giver_name(type(t) == "table" and t.task_giver_id) }, quiet) then
            n = n + 1
        end
    end
    return n
end

-- the givers of the player's tasks that ask for this artifact now (a container counts as it)
function asking(sec)
    local out = {}
    local tm = task_manager and task_manager.get_task_manager and task_manager.get_task_manager()
    local info = tm and tm.task_info
    if type(info) ~= "table" or not db.actor then
        return out
    end
    for task_id, t in pairs(info) do
        local want = load_var(db.actor, task_id .. "_fetch")
        if type(want) == "string" and almanac_found.artifact_of(want) == sec then
            out[#out + 1] = giver_name(type(t) == "table" and t.task_giver_id) or "?"
        end
    end
    table.sort(out)
    return out
end

-- up to n artifacts to tell the player of: unknown to him, turning up somewhere, those the Zone
-- makes on level lvl (its fields or Dynamic Anomalies' list) first, each part in random order
function word_of(n, lvl)
    local C = almanac_data.catalog()
    local here, elsewhere = {}, {}
    for _, sec in ipairs(C.order) do
        local a = C.artifacts[sec]
        if not almanac_page.known(sec) and almanac_page.turns_up(a) then
            local t = (lvl and ((a.fields and a.fields[lvl]) or (a.dao and a.dao[lvl]))) and here or elsewhere
            t[#t + 1] = sec
        end
    end
    local out = {}
    for _, t in ipairs({ here, elsewhere }) do
        for i = #t, 2, -1 do
            local j = math.random(i)
            t[i], t[j] = t[j], t[i]
        end
        for _, sec in ipairs(t) do
            if #out < n then
                out[#out + 1] = sec
            end
        end
    end
    return out
end

-- the game date, a day's mark
local function day()
    local y, mo, d = game.get_game_time():get()
    return y * 10000 + mo * 100 + d
end

-- a PDA's owner, as ui_pda_npc_tab registered it: the read mark holds this, so a PDA given to
-- another owner (the game reuses a released object's id) is read anew
local function owner_of(info)
    local c = type(info) == "table" and info.contact
    if type(c) ~= "table" then
        return "-"
    end
    return table.concat({ tostring(c.name), tostring(c.comm), tostring(c.rank) }, "|")
end

-- a PDA: its owner's notes, once; the number of artifacts learned
function on_pda(obj, quiet)
    local id = obj and obj:id()
    local size = id and PDA_SIZE[obj:section()]
    if not size then
        return 0
    end
    local info = se_load_var(id, obj:name(), "info")
    local who = owner_of(info)
    if se_load_var(id, obj:name(), READ) == who then
        return 0
    end
    local c = type(info) == "table" and info.contact
    if not (type(c) == "table" and c.name) then
        se_save_var(id, obj:name(), READ, who)
        return 0
    end
    if info.state == "encrypted" then
        return 0
    end
    se_save_var(id, obj:name(), READ, who)
    local n = 0
    for _, sec in ipairs(word_of(size, level.name())) do
        if almanac_found.learn(sec, { kind = "pda", who = c.name, place = almanac_found.place_of(db.actor) }, quiet) then
            n = n + 1
        end
    end
    return n
end

-- the PDAs in the pack (at a load, quietly, for those picked up before the Almanac; after a
-- decryption)
function scan_pdas(quiet)
    if not db.actor then
        return
    end
    db.actor:iterate_inventory(function(_, obj)
        if obj and PDA_SIZE[obj:section()] then
            on_pda(obj, quiet)
        end
    end, db.actor)
end

-- the decryption a technician sells: what it unlocks is read then
function wrap_decrypt()
    local t = ui_pda_npc_tab
    if not (t and type(t.unlock_encrypted_pda) == "function") or t.almanac_wrapped then
        return t ~= nil and t.almanac_wrapped == true
    end
    local orig = t.unlock_encrypted_pda
    t.unlock_encrypted_pda = function(...)
        local res = { orig(...) }
        pcall(scan_pdas, false)
        return unpack(res)
    end
    t.almanac_wrapped = true
    return true
end

---------------------------------------------------------------------------------------------
-- an Ecologist's talk (the dialog almanac_ecolog, added by modxml_almanac)
---------------------------------------------------------------------------------------------

local picks = {}    -- by an Ecologist's id: what he would tell, and who he is

local function npc_of(a, b)
    return (a and a:id() == AC_ID) and b or a
end

local function willing(npc)
    return npc and npc:alive() and npc:character_community() == "ecolog"
        and not (npc.relation and npc:relation(db.actor) == game_object.enemy)
end

-- a released NPC's id goes to the next one the game makes: a pick keeps whose it was
local function whose(npc)
    return npc:name() .. "|" .. npc:character_name()
end

-- a living Ecologist who isn't hostile, not talked to today, with something new to tell: what he
-- would tell is picked now, and picked again if the player has come to know it since
function talk_ok(a, b)
    local npc = npc_of(a, b)
    if not willing(npc) or se_load_var(npc:id(), npc:name(), TALKED) == day() then
        return false
    end
    local t = picks[npc:id()]
    if t and (t.who ~= whose(npc) or almanac_page.known(t.sec)) then
        t = nil
    end
    if not t then
        local sec = word_of(1, level.name())[1]
        t = sec and { sec = sec, who = whose(npc) } or nil
    end
    picks[npc:id()] = t
    return t ~= nil
end

function talk_text(a, b)
    local npc = npc_of(a, b)
    local t = npc and picks[npc:id()]
    if not t then
        return game.translate_string("st_almanac_talk_none")
    end
    return string.format(game.translate_string("st_almanac_talk"), almanac_data.catalog().artifacts[t.sec].name)
end

function talk_told(a, b)
    local npc = npc_of(a, b)
    local t = picks[npc:id()]
    picks[npc:id()] = nil
    se_save_var(npc:id(), npc:name(), TALKED, day())
    if t then
        almanac_found.learn(t.sec, { kind = "talk", who = npc:character_name(), place = almanac_found.place_of(npc) })
    end
end

local function actor_on_item_take(obj)
    if obj and PDA_SIZE[obj:section()] then
        on_pda(obj, false)
    end
end

local function actor_on_first_update()
    wrap_news()
    wrap_tip()
    wrap_decrypt()
    pcall(scan_pdas, true)
    next_check = time_global() + 1000
end

local function actor_on_update()
    if not next_check or time_global() < next_check then
        return
    end
    next_check = time_global() + CHECK_MS
    local ok, err = pcall(read_tasks, first_read)
    first_read = false
    if not ok then
        log("! tasks: %s", tostring(err))
    end
end

function on_game_start()
    RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
    RegisterScriptCallback("actor_on_update", actor_on_update)
    RegisterScriptCallback("actor_on_item_take", actor_on_item_take)
end
