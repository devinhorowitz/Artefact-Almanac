--[[
Artefact Almanac: the page in the PDA: the groups as tabs across the top, each a mark and a count,
then the artifacts of one beside the entry of one. almanac_page builds every word; this only lays
it out.

The entry is built anew for each artifact and added to its scroll view only once complete: a scroll
view measures its content when a window is added, never when one is resized. The stat card is the
inventory's own (utils_ui.get_stats_table and get_stats_xml), so its numbers are the inventory's.

The same page opens flat, on a key set in MCM: a window of its own in the 2D PDA's frame, drawn
straight to the screen and so as sharp as the inventory (the 3D PDA softens its pages). Escape or
the key again closes it.

An entry's recipe links to the crafting tree, which takes the tabs', list's and entry's place
until Back (or Escape, flat): a row per layer, the artifact at the top and each craft's artifacts
on the row below, wired to it, each with its icon, name (a link), a status and the parts its own
craft takes against what the player holds; each row says which book its crafts need
(almanac_page.tree has the words, almanac_trees.layers the places).
--]]

local SINGLETON, FLAT
-- the PDA's pages sit this far into the screen (pda_16.xml main); the flat window too, so its frame
-- and page land where the 2D PDA's do
local PDA_X, PDA_Y = 112, 34
local GAP = 6
local ROW_H = 22        -- a list row, as the Guide's (ui_almanac.xml item_height)
local TAB_GAP = 4       -- between two tabs
local MARK_GAP = 6      -- between a tab's mark and its count
local TAB_LIGHT = { off = 14, over = 34 }   -- a tab panel's white, by alpha: as it is, under the cursor
-- each group's mark (almanac_marks.dds, drawn by tools/make_art.py): tier N has N chevrons
local MARKS = {
    all = "almanac_mark_all", junk = "almanac_mark_junk", t1 = "almanac_mark_t1", t2 = "almanac_mark_t2",
    t3 = "almanac_mark_t3", t4 = "almanac_mark_t4", other = "almanac_mark_other", leads = "almanac_mark_leads",
}
local ROLES = {
    heading = { 238, 196, 112 }, body = { 200, 200, 200 }, dim = { 140, 140, 140 },
    good = { 56, 209, 115 }, warn = { 238, 155, 23 }, link = { 120, 175, 230 },
}
local MAX_LINKS = 48    -- an entry's lines that link to another artifact's entry, at most
-- the tree view's measures: the rows' book column; an artifact's column, at most; an artifact's
-- icon box (its width before the widescreen squeeze) and a part's; between two rows, where the
-- wires run
local TREE = { label_w = 80, slot_max = 176, icon_w = 30, icon_h = 34, part_w = 20, part_h = 13, gap = 26 }

local function argb(role)
    local c = ROLES[role] or ROLES.body
    return GetARGB(255, c[1], c[2], c[3])
end

local function say(msg)
    printf("[almanac-page] %s", tostring(msg))
end

-- where the player was, kept while the game runs: the group, the artifact, and the artifact whose
-- tree is open
local view = { group = "all", sec = nil, tree = nil }

-- a list's row: an artifact's name
class "AlmanacRow" (CUIListBoxItem)

function AlmanacRow:__init(xml, key, name_node, text, role) super(ROW_H)
    self.key = key
    self.name = xml:InitTextWnd(name_node, self)
    self.name:SetText(text)
    self.name:SetTextColor(argb(role))
end

class "AlmanacPage" (CUIScriptWnd)

function AlmanacPage:__init(flat) super()
    self.flat = flat == true
    local x, y = self.flat and PDA_X or 0, self.flat and PDA_Y or 0
    self:SetWndRect(Frect():set(x, y, x + 1024, y + 768))
    local xml = CScriptXmlInit()
    xml:ParseFile("ui_almanac.xml")
    self.xml = xml
    if self.flat then
        xml:InitStatic("flat_bezel", self)
        xml:InitTextWnd("flat_caption", self)
    end
    self.known_count = xml:InitTextWnd("known_count", self)
    self.btn_back = xml:Init3tButton("btn_back", self)
    self:Register(self.btn_back, "btn_back")
    self:AddCallback("btn_back", ui_events.BUTTON_CLICKED, self.OnBack, self)
    xml:InitStatic("rule_top", self)
    -- the group tabs: a slot for every group there could be, placed and filled by FillTabs; their
    -- panels, then the chosen one's light and underline, then the buttons with marks and counts
    local row = xml:InitStatic("tab_row", self)
    self.tab_x, self.tab_y, self.tab_w = row:GetWndPos().x, row:GetWndPos().y, row:GetWidth()
    self.tabs = {}
    for i = 1, #almanac_page.GROUPS do
        self.tabs[i] = { bg = xml:InitStatic("tab_bg", self) }
    end
    self.tab_on = xml:InitStatic("tab_on", self)
    self.tab_line = xml:InitStatic("tab_line", self)
    for i, slot in ipairs(self.tabs) do
        local btn = xml:Init3tButton("tab", self)
        self:Register(btn, "tab_" .. i)
        self:AddCallback("tab_" .. i, ui_events.BUTTON_CLICKED, function() self:OnTab(i) end, self)
        slot.btn, slot.mark, slot.count = btn, xml:InitStatic("tab_mark", btn), xml:InitTextWnd("tab_count", btn)
    end
    xml:InitStatic("rule_tabs", self)
    self.list_caption = xml:InitTextWnd("list_caption", self)
    self.art_list = xml:InitListBox("art_list", self)
    self:Register(self.art_list, "art_list")
    self:AddCallback("art_list", ui_events.LIST_ITEM_SELECT, self.OnArtifact, self)
    self.rule_art = xml:InitStatic("rule_art", self)
    self.detail = xml:InitScrollView("detail", self)
    -- the crafting tree, hidden until an entry's link opens it
    self.tree_back = xml:Init3tButton("tree_back", self)
    self:Register(self.tree_back, "tree_back")
    self:AddCallback("tree_back", ui_events.BUTTON_CLICKED, self.CloseTree, self)
    self.tree_title = xml:InitTextWnd("tree_title", self)
    self.tree_sum = xml:InitTextWnd("tree_sum", self)
    self.tree_view = xml:InitScrollView("tree_view", self)
    self.tree_parts = { self.tree_back, xml:InitTextWnd("tree_back_text", self), self.tree_title, self.tree_sum,
                        self.tree_view }
    for _, w in ipairs(self.tree_parts) do
        w:Show(false)
    end
    -- an entry's links: each ShowEntry registers its buttons under these names
    self.links = {}
    for k = 1, MAX_LINKS do
        self:AddCallback("link_" .. k, ui_events.BUTTON_CLICKED, function() self:OnLink(k) end, self)
    end
    xml:InitStatic("rule_foot", self)
    self.jailbreak_lbl = xml:InitTextWnd("jailbreak_lbl", self)
    self.credit = xml:InitTextWnd("credit", self)
    self.credit:SetText(string.format(game.translate_string("st_almanac_credit"), almanac_page.VERSION))
end

function AlmanacPage:__finalize()
    if self.flat then
        FLAT = nil
    else
        SINGLETON = nil
    end
end

-- everything afresh: what's carried, the counts, the groups, the artifacts, the entry
function AlmanacPage:Fill()
    local have = almanac_trees.carried()
    almanac_page.set_have(have, almanac_trees.with_stashes(have))
    local k, n, found = almanac_page.counts()
    self.known_count:SetText(string.format(game.translate_string("st_almanac_known_count"), k, n, found))
    self.jailbreak_lbl:Show(almanac_page.jailbreak())
    -- Back to Mod App Creator's launcher, in the PDA while the page has its tile
    self.btn_back:Show(not self.flat and almanac_tab.back_to_launcher())
    self.groups = almanac_page.groups()
    local keep
    for _, g in ipairs(self.groups) do
        keep = keep or g.id == view.group
    end
    if not keep then
        view.group = "all"
    end
    self:FillTabs()
    self:FillArtifacts()
    -- the tree that was open, still there
    if not (view.tree and self:ShowTree(view.tree)) then
        view.tree = nil
        self:Browse(true)
    end
end

-- the tabs, list and entry, or (on = false) the crafting tree in their place
function AlmanacPage:Browse(on)
    for _, slot in ipairs(self.tabs) do
        if not on then
            slot.btn:Show(false)
            slot.bg:Show(false)
        end
    end
    for _, w in ipairs({ self.tab_on, self.tab_line, self.list_caption, self.art_list, self.rule_art, self.detail }) do
        w:Show(on)
    end
    for _, w in ipairs(self.tree_parts) do
        w:Show(not on)
    end
    if on then
        self:FillTabs()
    end
end

-- the tabs share the row, one per group shown; each a mark and "known/total" centered, tinted
-- dim while none of its artifacts is known, the chosen one lit, underlined and amber
function AlmanacPage:FillTabs()
    local n = #self.groups
    local w = (self.tab_w - TAB_GAP * (n - 1)) / n
    local wide = utils_xml.is_widescreen() and 0.8 or 1
    for i, slot in ipairs(self.tabs) do
        local g = self.groups[i]
        slot.btn:Show(g ~= nil)
        slot.bg:Show(g ~= nil)
        if g then
            local x = self.tab_x + (i - 1) * (w + TAB_GAP)
            local on = g.id == view.group
            local role = on and "heading" or (g.known > 0 and "body" or "dim")
            slot.btn:SetWndPos(vector2():set(x, self.tab_y))
            slot.btn:SetWndSize(vector2():set(w, slot.btn:GetHeight()))
            slot.bg:SetWndPos(vector2():set(x, self.tab_y))
            slot.bg:SetWndSize(vector2():set(w, slot.bg:GetHeight()))
            slot.bg:SetTextureColor(GetARGB(TAB_LIGHT.off, 255, 255, 255))
            slot.over = false
            slot.mark:InitTexture(MARKS[g.id] or MARKS.other)
            slot.mark:SetTextureColor(argb(role))
            local mh = slot.mark:GetHeight()
            local mw = mh * wide
            -- the leads' tab counts them; the others, known of listed
            slot.count:SetText(g.id == "leads" and tostring(g.total) or string.format("%d/%d", g.known, g.total))
            slot.count:SetTextColor(argb(role))
            slot.count:AdjustWidthToText()
            local left = (w - (mw + MARK_GAP + slot.count:GetWidth())) / 2
            slot.mark:SetWndSize(vector2():set(mw, mh))
            slot.mark:SetWndPos(vector2():set(left, slot.mark:GetWndPos().y))
            slot.count:SetWndPos(vector2():set(left + mw + MARK_GAP, 0))
            if on then
                local h = slot.btn:GetHeight()
                self.tab_on:SetWndPos(vector2():set(x, self.tab_y))
                self.tab_on:SetWndSize(vector2():set(w, h))
                self.tab_line:SetWndPos(vector2():set(x, self.tab_y + h - self.tab_line:GetHeight()))
                self.tab_line:SetWndSize(vector2():set(w, self.tab_line:GetHeight()))
                self.list_caption:SetText(almanac_page.caption(g))
            end
        end
    end
end

function AlmanacPage:FillArtifacts()
    self.art_list:RemoveAll()
    local keep, first
    for i, r in ipairs(almanac_page.rows(view.group)) do
        local row = AlmanacRow(self.xml, r.sec, "art_name", r.name, r.known and "body" or "dim")
        self.art_list:AddExistingItem(row)
        if r.sec == view.sec then
            keep = i - 1
        end
        first = first or r.sec
    end
    if keep then
        self.art_list:SetSelectedIndex(keep)
        self:ShowEntry(view.sec)
    elseif first then
        self.art_list:SetSelectedIndex(0)
        self:ShowEntry(first)
    else
        self:ShowEntry(nil)
    end
    -- the selected row in view, near the middle: a refilled list keeps where it was scrolled, which
    -- can leave its top out of sight; again at the next update, once the PDA has shown the page
    self.art_scroll = math.max(0, (keep or 0) * ROW_H - self.art_list:GetHeight() / 2 + ROW_H)
    self:ScrollArt()
end

function AlmanacPage:ScrollArt()
    if self.art_scroll then
        local ok, top = pcall(function() return self.art_list:GetMaxScrollPos() end)
        top = ok and tonumber(top) or self.art_scroll
        self.art_list:SetScrollPos(math.max(0, math.min(self.art_scroll, top)))
    end
end

function AlmanacPage:Update()
    CUIScriptWnd.Update(self)
    if self.art_scroll then
        self:ScrollArt()
        self.art_scroll = nil
    end
    if self.link_next then
        local k = self.link_next
        self.link_next = nil
        self:FollowLink(k)
    end
    if self.detail_scroll then
        self.detail:SetScrollPos(self.detail_scroll)
        self.detail_scroll = nil
    end
    self:LightTabs()
    self:LightLinks()
end

-- the link under the cursor in amber
function AlmanacPage:LightLinks()
    if self.no_light then
        return
    end
    for _, l in ipairs(self.links) do
        local ok, over = pcall(l.btn.IsCursorOverWindow, l.btn)
        if not ok then
            self.no_light = true
            return
        end
        over = over == true
        if over ~= l.over then
            l.over = over
            l.text:SetTextColor(argb(over and "heading" or (l.role or "link")))
        end
    end
end

-- a link is followed at the next update, not in its own click: following it clears the view its
-- button is in
function AlmanacPage:OnLink(k)
    self.link_next = k
end

-- an artifact's entry, or its tree for the recipe's tree link, or (the survey's link) the question
-- asked and the entry shown again with it
function AlmanacPage:FollowLink(k)
    local l = self.links[k]
    if not l then
        return
    end
    if l.how == "survey" then
        local ok, err = pcall(almanac_survey.ask, l.sec)
        if not ok then
            say("! the survey: " .. tostring(err))
        end
        -- the entry again, scrolled where it was (now, and once more at the next update, as a scroll
        -- view settles its content late)
        local keep = self.detail:GetCurrentScrollPos()
        self:ShowEntry(l.sec)
        self.detail:SetScrollPos(keep)
        self.detail_scroll = keep
        return
    end
    if l.how == "tree" then
        self:ShowTree(l.sec)
        return
    end
    if view.tree then
        view.tree = nil
        self.tree_view:Clear()
        self:Browse(true)
    end
    self:GoTo(l.sec)
end

-- an artifact's entry, in the tab shown if it's listed there, else in All
function AlmanacPage:GoTo(sec)
    local here = false
    for _, r in ipairs(almanac_page.rows(view.group)) do
        here = here or r.sec == sec
    end
    if not here then
        view.group = "all"
    end
    view.sec = sec
    self:FillTabs()
    self:FillArtifacts()
    -- one the lists leave out (it never turns up and isn't known) still shows its entry
    if view.sec ~= sec then
        self:ShowEntry(sec)
    end
end

-- the tab under the cursor a little lighter; on an engine that can't tell, they stay as they are
function AlmanacPage:LightTabs()
    if self.no_light or not self.groups then
        return
    end
    for i, slot in ipairs(self.tabs) do
        if self.groups[i] then
            local ok, over = pcall(slot.btn.IsCursorOverWindow, slot.btn)
            if not ok then
                self.no_light = true
                return
            end
            over = over == true
            if over ~= slot.over then
                slot.over = over
                slot.bg:SetTextureColor(GetARGB(over and TAB_LIGHT.over or TAB_LIGHT.off, 255, 255, 255))
            end
        end
    end
end

function AlmanacPage:OnTab(i)
    local g = self.groups and self.groups[i]
    if g and g.id ~= view.group then
        view.group = g.id
        view.sec = nil
        self:FillTabs()
        self:FillArtifacts()
    end
end

function AlmanacPage:OnArtifact()
    local item = self.art_list:GetSelectedItem()
    if item and item.key ~= view.sec then
        self:ShowEntry(item.key)
    end
end

-- an item's inventory icon in a box, at most at its own size, centered; the icon, or nil
local function fit_icon(xml, parent, sec, bx, by, fw, fh)
    local tex = utils_xml.get_icons_texture(sec)
    local grid = utils_xml.get_item_axis(sec)
    local x1, y1, x2, y2 = utils_xml.get_item_axis(sec, nil, true)
    if type(x1) == "table" then
        local r = x1
        x1, y1 = r.x1, r.y1
        x2 = r.x2 or (r.x1 and r.w and r.x1 + r.w)
        y2 = r.y2 or (r.y1 and r.h and r.y1 + r.h)
    end
    if not (tex and type(grid) == "table" and x1 and y1 and x2 and y2) then
        return
    end
    local w0, h0 = x2 - x1, y2 - y1
    local sw, sh = grid.w or w0, grid.h or h0
    local wide = utils_xml.is_widescreen() and 0.8 or 1
    local k = math.min(fw / (sw * wide), fh / sh, 1)
    local w, h = sw * wide * k, sh * k
    local icon = xml:InitStatic("entry_icon", parent)
    icon:InitTexture(tex)
    icon:SetTextureRect(Frect():set(x1, y1, x2, y2))
    icon:SetStretchTexture(true)
    icon:SetWndSize(vector2():set(w, h))
    icon:SetWndPos(vector2():set(bx + (fw - w) / 2, by + (fh - h) / 2))
    return icon
end

-- an artifact's inventory icon in the frame
local function put_icon(xml, parent, frame, sec)
    local p = frame:GetWndPos()
    return fit_icon(xml, parent, sec, p.x, p.y, frame:GetWidth(), frame:GetHeight())
end

-- the inventory's stat card rows for an artifact, in its order; returns the next y. A row is the
-- inventory's (utils.xml stats_box; utils_16.xml on a widescreen, which the engine loads in its
-- place), whose label wraps in its column (125 wide, 100 on a widescreen) and grows past the row
-- (a long Russian one does): each label is measured in a see-through text of the same size
-- (entry_card_cap), and the rows under a wrapped one move down by what it grew
local function card(xml, entry, sec, y)
    local tbl = utils_ui.get_stats_table(sec)
    if not tbl then
        return y
    end
    local stats = {}
    for stat, gr in pairs(tbl) do
        stats[#stats + 1] = { stat = stat, gr = gr }
    end
    table.sort(stats, function(a, b) return (a.gr.index or 0) < (b.gr.index or 0) end)
    local probe = xml:InitTextWnd("entry_card_cap", entry)
    probe:SetWndSize(vector2():set(utils_xml.is_widescreen() and 100 or 125, probe:GetHeight()))
    probe:SetTextColor(GetARGB(0, 0, 0, 0))
    probe:SetText("A")
    probe:AdjustHeightToText()
    local one = probe:GetHeight()
    for _, s in ipairs(stats) do
        local ok, st = pcall(utils_ui.get_stats_xml, entry, nil, sec, s.gr, s.stat)
        if ok and st then
            st:SetWndPos(vector2():set(0, y))
            probe:SetText(game.translate_string(s.gr.name or ""))
            probe:AdjustHeightToText()
            y = y + st:GetHeight() + math.max(0, probe:GetHeight() - one)
        end
    end
    return y
end

function AlmanacPage:ShowEntry(sec)
    view.sec = sec
    self.links = {}
    self.detail:Clear()
    if not sec then
        return
    end
    local e = almanac_page.entry(sec)
    if not e then
        return
    end
    local xml = self.xml
    local entry = xml:InitStatic("entry", nil)
    local y = 0
    if e.known then
        xml:InitStatic("entry_icon_bg", entry)
        put_icon(xml, entry, xml:InitStatic("entry_icon_frame", entry), sec)
        y = 104
    end
    -- a line; one naming another artifact (link) in the link color, with a clear button over it
    -- that goes to that artifact's entry, or (how) opens the artifact's crafting tree ("tree") or
    -- asks the survey about it ("survey")
    local function line(node, s, role, link, how)
        local t = xml:InitTextWnd(node, entry)
        t:SetWndPos(vector2():set(0, y))
        t:SetText(s)
        if link and #self.links < MAX_LINKS then
            role = "link"
        else
            link = nil
        end
        if role then
            t:SetTextColor(argb(role))
        end
        if node == "entry_line" or node == "entry_name" then
            t:AdjustHeightToText()
        end
        if link then
            local k = #self.links + 1
            local btn = xml:Init3tButton("entry_link", entry)
            btn:SetWndPos(vector2():set(0, y))
            btn:SetWndSize(vector2():set(entry:GetWidth(), t:GetHeight()))
            self:Register(btn, "link_" .. k)
            self.links[k] = { sec = link, text = t, btn = btn, how = how }
        end
        y = y + t:GetHeight() + 2
        return t
    end
    local function rule()
        local r = xml:InitStatic("entry_rule", entry)
        r:SetWndPos(vector2():set(0, y + GAP / 2))
        y = y + 1 + GAP
    end
    line("entry_name", e.name)
    if e.found then
        line("entry_line", e.found[1], e.found[2])
    end
    if e.kind then
        line("entry_line", e.kind, "dim")
    end
    if e.weight then
        line("entry_line", e.weight, "dim")
    end
    if e.known then
        y = y + GAP
        y = card(xml, entry, sec, y)
        if e.description and e.description ~= "" then
            y = y + GAP
            line("entry_line", e.description, "body")
        end
    end
    self.survey_y = nil
    for _, b in ipairs(e.blocks) do
        if b.heading then
            rule()
            -- where the survey's block starts, to keep it in view after a question
            if b.survey then
                self.survey_y = y
            end
            line("entry_heading", b.heading)
        end
        for _, l in ipairs(b.lines) do
            line("entry_line", l[1], l[2], l[3], l[4])
        end
    end
    entry:SetWndSize(vector2():set(entry:GetWidth(), y + GAP))
    self.detail:AddWindow(entry, true)
    entry:SetAutoDelete(true)
end

-- an artifact's crafting tree in the tabs', list's and entry's place: false when nothing makes it.
-- Each row is built at its own top as a block per artifact (measured: a name or a part can wrap),
-- the next row below the tallest; then the wires, from each icon down to a bar over its children
function AlmanacPage:ShowTree(sec)
    local tr = sec and almanac_page.tree(sec)
    if not tr then
        return false
    end
    view.tree = sec
    self:Browse(false)
    self.links = {}
    self.tree_view:Clear()
    self.tree_title:SetText(tr.title)
    self.tree_sum:SetText(tr.sum)
    local xml = self.xml
    local canvas = xml:InitStatic("tree_canvas", nil)
    local W = canvas:GetWidth()
    local area = W - TREE.label_w
    local slot = math.min(TREE.slot_max, area / math.max(1, tr.leaves))
    local x0 = TREE.label_w + (area - slot * tr.leaves) / 2
    local function text(node, parent, x, y, w, s, role)
        local t = xml:InitTextWnd(node, parent)
        t:SetWndPos(vector2():set(x, y))
        t:SetWndSize(vector2():set(w, t:GetHeight()))
        t:SetText(s)
        t:SetTextColor(argb(role))
        t:AdjustHeightToText()
        return t
    end
    local function faded(icon, role)
        if icon and role == "dim" then
            icon:SetTextureColor(GetARGB(90, 255, 255, 255))
        end
    end
    local placed = {}   -- node -> its icon's center and its row's top
    local top = 4
    for _, row in ipairs(tr.rows) do
        local rc = xml:InitStatic("tree_node", canvas)
        rc:SetWndPos(vector2():set(0, top))
        -- the row's book, its crafts, and whether the book is read
        local lw = TREE.label_w - 6
        local h = text("tree_label", rc, 0, 0, lw, row.label, row.label_role):GetHeight()
        h = h + text("tree_text", rc, 0, h, lw, row.sub, "dim"):GetHeight()
        if row.unread then
            h = h + text("tree_text", rc, 0, h, lw, row.unread, "warn"):GetHeight()
        end
        for _, n in ipairs(row.nodes) do
            local bx = x0 + (n.slot - 0.5) * slot + 3
            local tx = bx + TREE.icon_w + 4
            local tw = slot - 6 - TREE.icon_w - 4
            faded(fit_icon(xml, rc, n.sec, bx, 0, TREE.icon_w, TREE.icon_h), n.role)
            local name = text("tree_name", rc, tx, 0, tw, n.name, n.role)
            if #self.links < MAX_LINKS then
                local k = #self.links + 1
                local btn = xml:Init3tButton("entry_link", rc)
                btn:SetWndPos(vector2():set(tx, 0))
                btn:SetWndSize(vector2():set(tw, name:GetHeight()))
                self:Register(btn, "link_" .. k)
                self.links[k] = { sec = n.sec, text = name, btn = btn, role = n.role }
            end
            local y = name:GetHeight()
            if n.status then
                y = y + text("tree_text", rc, tx, y, tw, n.status[1], n.status[2]):GetHeight()
            end
            -- a line per part: its icon, its name and what's held of what it takes, colored
            for _, l in ipairs(n.lines) do
                faded(fit_icon(xml, rc, l.sec, tx, y + 2, TREE.part_w, TREE.part_h), l.role)
                local c = ROLES[l.role] or ROLES.body
                local s = string.format("%s %%c[255,%d,%d,%d]%s", l.name, c[1], c[2], c[3], l.count)
                local lt = text("tree_text", rc, tx + TREE.part_w + 3, y, tw - TREE.part_w - 3, s,
                                l.role == "dim" and "dim" or "body")
                y = y + math.max(TREE.part_h + 3, lt:GetHeight())
            end
            h = math.max(h, y, TREE.icon_h)
            placed[n] = { cx = bx + TREE.icon_w / 2, top = top }
        end
        rc:SetWndSize(vector2():set(W, h))
        top = top + h + TREE.gap
    end
    -- the wires: down from an artifact's icon, along a bar, down to each of its children's
    local thin = 2 * (utils_xml.is_widescreen() and 0.8 or 1)
    local function wire(x, y, w, h, dim)
        if w > 0 and h > 0 then
            local s = xml:InitStatic("tree_wire", canvas)
            s:SetWndPos(vector2():set(x, y))
            s:SetWndSize(vector2():set(w, h))
            if dim then
                s:SetTextureColor(GetARGB(255, 60, 60, 60))
            end
        end
    end
    for n, p in pairs(placed) do
        if #n.kids > 0 and placed[n.kids[1]] then
            local dim = n.state == "under" or n.state == "carried"
            local bar = placed[n.kids[1]].top - TREE.gap / 2
            local from = p.top + TREE.icon_h + 2
            wire(p.cx - thin / 2, from, thin, bar - from, dim)
            local lo, hi = p.cx, p.cx
            for _, k in ipairs(n.kids) do
                local q = placed[k]
                lo, hi = math.min(lo, q.cx), math.max(hi, q.cx)
                wire(q.cx - thin / 2, bar, thin, q.top - 2 - bar, dim)
            end
            wire(lo - thin / 2, bar - 1, hi - lo + thin, 2, dim)
        end
    end
    canvas:SetWndSize(vector2():set(W, top - TREE.gap + 8))
    self.tree_view:AddWindow(canvas, true)
    canvas:SetAutoDelete(true)
    return true
end

-- back from the tree to the entry
function AlmanacPage:CloseTree()
    view.tree = nil
    self.tree_view:Clear()
    self:Browse(true)
    self:ShowEntry(view.sec)
end

-- Back to Mod App Creator's launcher, where the tile opened the page
function AlmanacPage:OnBack()
    if self.flat then
        self:Close()
        return
    end
    local m = ActorMenu.get_pda_menu()
    if m then
        m:SetActiveSubdialog("eptLauncher")
    end
end

function AlmanacPage:Reset()
    local ok, err = pcall(function() self:Fill() end)
    if not ok then
        say("! the page could not be filled: " .. tostring(err))
    end
end

function AlmanacPage:Close()
    if self:IsShown() then
        self:HideDialog()
    end
end

-- flat, Escape and the page's key close it, Escape the tree first; in the PDA, the keys are the PDA's
function AlmanacPage:OnKeyboard(dik, action)
    local res = CUIScriptWnd.OnKeyboard(self, dik, action)
    if res then
        return res
    end
    if self.flat and action == ui_events.WINDOW_KEY_PRESSED then
        if dik == DIK_keys.DIK_ESCAPE and view.tree then
            self:CloseTree()
            return true
        end
        if dik == DIK_keys.DIK_ESCAPE or dik == almanac_tab.key() then
            self:Close()
            return true
        end
    end
    return false
end

-- the page next opens on an artifact's entry, in the "all" group; a page shown now goes there at
-- once (another app's link, or a test)
function show_next(sec)
    view.group, view.sec, view.tree = "all", sec, nil
    -- false, not nil, for a page not made yet: ipairs stops at the first nil
    for _, w in ipairs({ SINGLETON or false, FLAT or false }) do
        if w and w:IsShown() then
            w:Reset()
        end
    end
end

-- the same, on the artifact's crafting tree
function show_tree(sec)
    view.group, view.sec, view.tree = "all", sec, sec
    for _, w in ipairs({ SINGLETON or false, FLAT or false }) do
        if w and w:IsShown() then
            w:Reset()
        end
    end
end

-- the entry's scroll view, for a test that scrolls it
function detail_of(w)
    return w and w.detail
end

-- the entry shown, scrolled to its survey block (a check's captures use it)
function show_survey(w)
    if w and w.survey_y then
        w.detail:SetScrollPos(w.survey_y)
        w.detail_scroll = w.survey_y
        return true
    end
    return false
end

-- the tree's scroll view, the same
function tree_of(w)
    return w and w.tree_view
end

-- the page for the PDA's tab or MAC's tile, filled afresh each time it's shown
function get_ui()
    SINGLETON = SINGLETON or AlmanacPage()
    SINGLETON:Reset()
    return SINGLETON
end

function open_flat()
    FLAT = FLAT or AlmanacPage(true)
    if not FLAT:IsShown() then
        FLAT:Reset()
        FLAT:ShowDialog(true)
    end
    return FLAT
end

function close_flat()
    if FLAT then
        FLAT:Close()
    end
end

function flat_window()
    return (FLAT and FLAT:IsShown()) and FLAT or nil
end
