--[[
Artefact Almanac: what the page shows, as text, built from the catalog (almanac_data) and the
trees (almanac_trees), so it can be tested away from the UI; ui_almanac.script only lays it out.
Every word is a string id.

What the player knows: an artifact they have found (almanac_found: one has been in their
inventory), one they carry, one whose PDA Guide article is open, or everything with MCM's jailbreak. An unknown artifact is listed as unknown, and only once some way of
the Zone makes it (a field, Dynamic Anomalies, a recipe); a known one is always listed.

    almanac_page.groups()            the left column: { { id, name, known, total }, ... }
    almanac_page.rows(group)         the middle column: { { sec, name, known }, ... }
    almanac_page.entry(sec, have)    the right column: { name, sec, known, blocks = { { heading,
                                     lines = { { text, role }, ... } }, ... } }
    almanac_page.tree(sec, have)     the crafting tree view: its layers, rows and nodes in words
--]]

VERSION = "1.0.1"

-- the page's tabs, in order: every artifact, then junk, then each tier as the game shows it, then
-- the rest. A group's tier is the configs' (see shown_tier): tier 1 holds the configs' tier 2
GROUPS = {
    { id = "all" },
    { id = "junk", kind = "i_arty_junk" },
    { id = "t1", tier = 2 }, { id = "t2", tier = 3 }, { id = "t3", tier = 4 }, { id = "t4", tier = 5 },
    { id = "other" },
}
MAX_LEVELS = 8      -- levels a "where" line names before "and N more"

local function t(id)
    return game.translate_string(id)
end

local function f(id, ...)
    return string.format(t(id), ...)
end

local function name_of(sec)
    local n = ini_sys:r_string_ex(sec, "inv_name")
    return n and t(n) or sec
end

-- MCM's jailbreak: everything known
function jailbreak()
    local ok, v = pcall(function() return ui_mcm and ui_mcm.get("almanac/jailbreak") end)
    return ok and v == true
end

function found(sec)
    return almanac_found ~= nil and almanac_found.is_found(sec) == true
end

-- heard of without holding one (almanac_learn: the radio, a task)
function learned(sec)
    return almanac_found ~= nil and almanac_found.is_learned(sec) == true
end

-- whether the player knows an artifact: the jailbreak, a find, carrying one, or its Guide article
-- open
function known(sec, have)
    if jailbreak() then
        return true
    end
    if found(sec) or learned(sec) then
        return true
    end
    if have and (have[sec] or 0) > 0 then
        return true
    end
    local ok, open = pcall(function()
        return ui_pda_encyclopedia_tab.is_unlocked_article("encyclopedia_artefacts_" .. sec)
    end)
    return ok and open == true
end

-- whether the Zone makes it some way the catalog sees: a field, Dynamic Anomalies, a recipe
function turns_up(a)
    return next(a.fields) ~= nil or next(a.dao) ~= nil or a.dao_random or #a.made_by > 0
end

-- whether a group holds an artifact
function in_group(g, a)
    if g.id == "all" then
        return true
    end
    if g.kind then
        return a.kind == g.kind
    end
    if g.tier then
        return a.kind ~= "i_arty_junk" and a.tier == g.tier
    end
    -- the rest: artifacts with no tier, or one outside the groups above
    if a.kind == "i_arty_junk" then
        return false
    end
    return not (a.tier and a.tier >= 2 and a.tier <= 5)
end

local function listed(a, have)
    return known(a.sec, have) or turns_up(a)
end

local _have, _supply, _range
-- what the player carries, read once per page fill (the UI passes it in)
local function carry(have)
    return have or _have or {}
end

-- what the page crafts with, and the stash range: a caller's have alone; the page's own fill, its
-- supply (the stashes in range too)
local function supply_for(have)
    if have == nil and _supply then
        return _supply, _range
    end
    return carry(have), nil
end

-- what the player carries (what's known by it), and what he can craft with: with Craft From
-- Stashes, that and the stashes within range (almanac_trees.with_stashes), and the range
function set_have(have, supply, range)
    _have, _supply, _range = have, supply, range
end

function groups(have)
    have = carry(have)
    local C = almanac_data.catalog()
    local out = {}
    for _, g in ipairs(GROUPS) do
        local total, k, fd = 0, 0, 0
        for _, sec in ipairs(C.order) do
            local a = C.artifacts[sec]
            if in_group(g, a) and listed(a, have) then
                total = total + 1
                if known(sec, have) then
                    k = k + 1
                end
                if found(sec) then
                    fd = fd + 1
                end
            end
        end
        if total > 0 or g.id == "all" then
            out[#out + 1] = { id = g.id, name = t("st_almanac_group_" .. g.id), known = k, total = total, found = fd }
        end
    end
    return out
end

-- a group's caption over its artifacts, from groups(): "Tier 4: 1 of 10 known, 0 found"
function caption(g)
    return f("st_almanac_tab_caption", g.name, g.known, g.total, g.found)
end

-- a name as the list sorts it: opening quotes and spaces left out (Artefact Hunter's artifacts are
-- quoted: "Lung", and in Russian with the cp1251 guillemets, bytes 171 and 187), case ignored
function sort_key(name)
    return string.lower((name:gsub('^[%s"\'\171\187]+', "")))
end

-- a group's artifacts: the known by name, then the unknown
function rows(group_id, have)
    have = carry(have)
    local C = almanac_data.catalog()
    local g
    for _, x in ipairs(GROUPS) do
        if x.id == group_id then
            g = x
        end
    end
    local kn, unk = {}, {}
    for _, sec in ipairs(C.order) do
        local a = C.artifacts[sec]
        if g and in_group(g, a) and listed(a, have) then
            if known(sec, have) then
                kn[#kn + 1] = { sec = sec, name = a.name, known = true }
            else
                unk[#unk + 1] = { sec = sec, name = t("st_almanac_unknown"), known = false }
            end
        end
    end
    table.sort(kn, function(x, y)
        local a, b = sort_key(x.name), sort_key(y.name)
        if a ~= b then
            return a < b
        end
        return x.sec < y.sec
    end)
    for _, r in ipairs(unk) do
        kn[#kn + 1] = r
    end
    return kn
end

-- names joined, at most MAX_LEVELS of them, then "and N more"
function joined(names)
    if #names <= MAX_LEVELS then
        return table.concat(names, ", ")
    end
    local head = {}
    for i = 1, MAX_LEVELS do
        head[i] = names[i]
    end
    return f("st_almanac_and_more", table.concat(head, ", "), #names - MAX_LEVELS)
end

-- levels by a number each (higher first, then by name), as level names
local function by_weight(weights)
    local list = {}
    for lvl, w in pairs(weights) do
        list[#list + 1] = { lvl = lvl, w = w, name = t(lvl) }
    end
    table.sort(list, function(x, y)
        if x.w ~= y.w then
            return x.w > y.w
        end
        return x.name < y.name
    end)
    local names = {}
    for i, x in ipairs(list) do
        names[i] = x.name
    end
    return names
end

-- an artifact's tier as the game shows it: the configs' less one (Perk-Based Artefacts lowers every
-- tier of 2 or more by one, and GRIP's icons carry that many chevrons); junk shows none
function shown_tier(a)
    if a.kind ~= "i_arty_junk" and a.tier and a.tier >= 2 then
        return a.tier - 1
    end
end

-- the kind and tier line
-- Klondaik's names for its artifact levels (k_art_level), its own strings, as its Melter shows them
local ART_LEVELS = {
    [-1] = "st_art_level_m1", [0] = "st_art_level_0", [1] = "st_art_level_1", [2] = "st_art_level_2",
    [3] = "st_art_level_3", [4] = "st_art_level_4", [5] = "st_art_level_5", [6] = "st_art_level_6",
    [7] = "st_art_level_absolut", [8] = "st_art_level_base", [9] = "st_art_level_modificat",
    [10] = "st_art_level_mezomodificat", [11] = "st_art_level_hypermodificat", [12] = "st_art_level_syn_absolut",
    [13] = "st_art_level_1_unique", [14] = "st_art_level_2_unique", [15] = "st_art_level_3_unique",
    [16] = "st_art_level_4_unique", [17] = "st_art_level_absolute_unique",
}

function kind_line(a)
    local s
    if a.kind == "i_arty_junk" then
        s = t("st_almanac_kind_junk")
    else
        local n = shown_tier(a)
        s = n and f("st_almanac_kind_arty_tier", n) or t("st_almanac_kind_arty")
    end
    -- with Klondaik, its own level too, which its descriptions call "Level: Tier N"
    local id = a.art_level and ART_LEVELS[a.art_level]
    if id then
        s = f("st_almanac_kind_level", s, t(id))
    end
    return s
end

-- a mutant part (GAMMA's kinds: parts, raw meats, belt hides), as against any other item a recipe
-- takes (Klondaik's take drugs, kerosene, bandages)
function is_mutant_part(sec)
    local kind = ini_sys:r_string_ex(sec, "kind")
    if kind then
        return kind:find("^i_mutant") ~= nil
    end
    return sec:find("^mutant_part_") ~= nil
end

-- totals' parts as { mutant parts, other items }
local function part_split(parts)
    local m, o = 0, 0
    for sec, n in pairs(parts) do
        if is_mutant_part(sec) then
            m = m + n
        else
            o = o + n
        end
    end
    return m, o
end

local function detectors_block(C, a)
    local names = {}
    for _, d in ipairs(a.detectors) do
        if not d:find("^mp_") then
            names[#names + 1] = name_of(d)
        end
    end
    table.sort(names)
    -- one name per detector model: two sections can share one
    local uniq, last = {}, nil
    for _, n in ipairs(names) do
        if n ~= last then
            uniq[#uniq + 1] = n
            last = n
        end
    end
    local lines = { { #uniq > 0 and table.concat(uniq, ", ") or t("st_almanac_detectors_none"), #uniq > 0 and "body" or "dim" } }
    return { heading = t("st_almanac_h_detectors"), lines = lines }
end

local function where_block(C, a)
    local lines = {}
    local fw = {}
    for lvl, ps in pairs(a.fields) do
        local best = 0
        for _, p in ipairs(ps) do
            best = math.max(best, p)
        end
        fw[lvl] = best
    end
    if next(fw) then
        lines[#lines + 1] = { f("st_almanac_fields", joined(by_weight(fw))), "body" }
    end
    if next(a.dao) then
        lines[#lines + 1] = { f("st_almanac_dao", joined(by_weight(a.dao))), "body" }
    end
    if a.dao_random then
        lines[#lines + 1] = { t("st_almanac_dao_random"), "body" }
    end
    if #lines == 0 then
        lines[#lines + 1] = { #a.made_by > 0 and t("st_almanac_where_craft_only") or t("st_almanac_where_none"), "dim" }
    end
    return { heading = t("st_almanac_h_where"), lines = lines }
end

local function parts_text(parts, eager)
    local out = {}
    for _, p in ipairs(parts) do
        out[#out + 1] = f("st_almanac_part", name_of(p[1]), almanac_trees.amount(p[2], eager))
    end
    return table.concat(out, ", ")
end

local function book_text(book)
    local n = ini_sys:section_exist(book) and name_of(book) or nil
    if not n then
        return t("st_almanac_book_builtin")
    end
    if not almanac_trees.book_known(book) then
        return f("st_almanac_book_unread", n)
    end
    return n
end

local function sorted_names(set)
    local out = {}
    for name in pairs(set or {}) do
        out[#out + 1] = name
    end
    table.sort(out)
    return out
end

-- where a book or the Melter comes from: who sells it ("Sold by Professor Hermann"), and who may
-- carry one ("Carried by Legend-rank stalkers (4%)"), by the catalog's sources
function source_text(C, item)
    local s = C.sources and C.sources[item]
    if not s then
        return nil
    end
    local out = {}
    local sellers = sorted_names(s.sellers)
    if #sellers > 0 then
        out[#out + 1] = f("st_almanac_src_sold", table.concat(sellers, ", "))
    end
    if #s.drops > 0 then
        local ranks, lo, hi = {}, nil, nil
        for _, d in ipairs(s.drops) do
            ranks[d.rank] = true
            lo = math.min(lo or d.chance, d.chance)
            hi = math.max(hi or d.chance, d.chance)
        end
        local pct = lo == hi and string.format("%g%%", lo * 100) or string.format("%g-%g%%", lo * 100, hi * 100)
        if ranks[""] then
            out[#out + 1] = f("st_almanac_src_carried_any", pct)
        else
            local names = {}
            for _, r in ipairs(almanac_data.RANKS) do
                if ranks[r] then
                    names[#names + 1] = t("st_rank_" .. r)
                end
            end
            out[#out + 1] = f("st_almanac_src_carried", table.concat(names, ", "), pct)
        end
    end
    if #out == 0 then
        return t("st_almanac_src_none")
    end
    return table.concat(out, ". ") .. "."
end

-- each recipe that makes it. The one the trees take first: its book (and, while it's unread, where
-- the book comes from), then a line per part, an artifact's a link to it. The others dimmed, a
-- line each
local function made_block(C, a, eager)
    local by_key = {}
    for _, r in ipairs(C.recipes) do
        by_key[r.key] = r
    end
    local lines = {}
    for i, key in ipairs(a.made_by) do
        local r = by_key[key]
        if r and i == 1 then
            -- the whole tree, layer by layer, in the page's tree view
            lines[#lines + 1] = { t("st_almanac_tree_open"), "body", a.sec, "tree" }
            local unread = not almanac_trees.book_known(r.book)
            lines[#lines + 1] = { f("st_almanac_made_book", book_text(r.book)), unread and "warn" or "body" }
            local src = unread and source_text(C, r.book)
            if src then
                lines[#lines + 1] = { src, "dim" }
            end
            for _, p in ipairs(r.parts) do
                local art = C.artifacts[p[1]] and p[1] or nil
                lines[#lines + 1] = { f("st_almanac_part", name_of(p[1]), almanac_trees.amount(p[2], eager)),
                                      art and "body" or "dim", art }
            end
        elseif r then
            lines[#lines + 1] = { f("st_almanac_made_other", book_text(r.book), parts_text(r.parts, eager)), "dim" }
        end
    end
    if #lines == 0 then
        lines[1] = { t("st_almanac_made_none"), "dim" }
    end
    return { heading = t("st_almanac_h_made"), lines = lines }
end

local function into_block(C, a)
    local lines = {}
    for _, u in ipairs(almanac_trees.up(a.sec, C)) do
        local name = C.artifacts[u.sec].name
        lines[#lines + 1] = { u.depth == 1 and name or f("st_almanac_into_later", name), u.depth == 1 and "body" or "dim",
                              u.sec }
    end
    if #lines == 0 then
        lines[1] = { t("st_almanac_into_none"), "dim" }
    end
    return { heading = t("st_almanac_h_into"), lines = lines }
end

-- who may ask the player for one: the player's own tasks that ask now, then the givers of fetch
-- tasks that can ask for it, by name and by faction
local function wanted_block(C, a)
    local lines = {}
    local ok, now = pcall(function() return almanac_learn and almanac_learn.asking(a.sec) end)
    for _, who in ipairs(ok and now or {}) do
        lines[#lines + 1] = { f("st_almanac_wanted_now", who), "good" }
    end
    local W = C.wanted
    if W and W.arts[a.sec] then
        local names = sorted_names(W.names)
        local factions = {}
        for c in pairs(W.factions) do
            factions[#factions + 1] = t(c)
        end
        table.sort(factions)
        if #names > 0 then
            lines[#lines + 1] = { f("st_almanac_wanted_named", table.concat(names, ", ")), "body" }
        end
        if #factions > 0 then
            lines[#lines + 1] = { f("st_almanac_wanted_factions", table.concat(factions, ", ")), "body" }
        end
        if #names == 0 and #factions == 0 then
            lines[#lines + 1] = { t("st_almanac_wanted_some"), "body" }
        end
    end
    if #lines == 0 then
        lines[1] = { t("st_almanac_wanted_none"), "dim" }
    end
    return { heading = t("st_almanac_h_wanted"), lines = lines }
end

-- counts as "name xN" lines, most first, then by name; an artifact's line a link to it
local function count_lines(C, counts, role)
    local list = {}
    for sec, n in pairs(counts) do
        list[#list + 1] = { name = name_of(sec), n = n, sec = C.artifacts[sec] and sec or nil }
    end
    table.sort(list, function(x, y)
        if x.n ~= y.n then
            return x.n > y.n
        end
        return x.name < y.name
    end)
    local lines = {}
    for _, x in ipairs(list) do
        lines[#lines + 1] = { f("st_almanac_part", x.name, x.n), role, x.sec }
    end
    return lines
end

local function totals_block(C, a, eager)
    local tt = almanac_trees.totals(a.sec, eager, C)
    if not tt then
        return nil
    end
    local n_arts = 0
    for _, n in pairs(tt.artifacts) do
        n_arts = n_arts + n
    end
    local m, o = part_split(tt.parts)
    local head = o > 0 and f("st_almanac_totals_items", tt.crafts, n_arts, m, o) or f("st_almanac_totals", tt.crafts, n_arts, m)
    local lines = { { head, "body" } }
    for _, l in ipairs(count_lines(C, tt.artifacts, "body")) do
        lines[#lines + 1] = l
    end
    for _, l in ipairs(count_lines(C, tt.parts, "dim")) do
        lines[#lines + 1] = l
    end
    return { heading = t("st_almanac_h_totals"), lines = lines }
end

local function need_block(C, a, have, eager, range)
    local nd = almanac_trees.need(a.sec, have, eager, C)
    if not nd then
        return nil
    end
    local lines = {}
    if nd.done then
        lines[1] = { f("st_almanac_need_done", nd.crafts), "good" }
    else
        lines[1] = { f("st_almanac_need_missing", nd.crafts, nd.missing_count), "body" }
        for _, l in ipairs(count_lines(C, nd.missing, "warn")) do
            lines[#lines + 1] = l
        end
    end
    -- no Melter with you, and where one comes from
    if nd.crafts > 0 and (have[almanac_data.MELTER] or 0) == 0 then
        lines[#lines + 1] = { f("st_almanac_need_melter", source_text(C, almanac_data.MELTER) or ""), "warn" }
    end
    -- each book not read yet, and where it comes from
    local unread = {}
    for book in pairs(nd.books) do
        if not almanac_trees.book_known(book) then
            unread[#unread + 1] = { name = name_of(book), book = book }
        end
    end
    table.sort(unread, function(x, y) return x.name < y.name end)
    for _, u in ipairs(unread) do
        lines[#lines + 1] = { f("st_almanac_need_book", u.name, source_text(C, u.book) or ""), "warn" }
    end
    -- what was counted besides the pack
    if range then
        lines[#lines + 1] = { f("st_almanac_need_stashes", range), "dim" }
    end
    return { heading = t("st_almanac_h_need"), lines = lines }
end

-- the entry for an artifact, or for an unknown one only that it's unknown
function entry(sec, have)
    -- the page's own fill crafts with its supply (the stashes in range too); a caller's have alone
    local supply, range = supply_for(have)
    have = carry(have)
    local C = almanac_data.catalog()
    local a = C.artifacts[sec]
    if not a then
        return nil
    end
    if not known(sec, have) then
        return { sec = sec, known = false, name = t("st_almanac_unknown"),
                 blocks = { { lines = { { t("st_almanac_unknown_entry"), "dim" } } } } }
    end
    local eager = almanac_trees.eager_now()
    local e = { sec = sec, known = true, name = a.name, kind = kind_line(a),
                weight = a.weight and f("st_almanac_weight", string.format("%.2f", a.weight)) or nil,
                description = t(ini_sys:r_string_ex(sec, "description") or ""), blocks = {} }
    -- when, how and where it was found; else when and how it was heard of; else that it hasn't
    -- been found
    local at = almanac_found and almanac_found.found_at(sec)
    local heard = not at and almanac_found and almanac_found.learned_at(sec)
    if at then
        e.found = { f("st_almanac_found_on", almanac_found.date_of(at), almanac_found.describe(at)), "good" }
    elseif heard then
        e.found = { f("st_almanac_learned_on", almanac_found.date_of(heard), almanac_found.describe(heard)), "heading" }
    else
        e.found = { t("st_almanac_not_found"), "dim" }
    end
    local function put(b)
        if b then
            e.blocks[#e.blocks + 1] = b
        end
    end
    put(detectors_block(C, a))
    put(where_block(C, a))
    put(made_block(C, a, eager))
    put(into_block(C, a))
    put(wanted_block(C, a))
    put(totals_block(C, a, eager))
    put(need_block(C, a, supply, eager, range))
    return e
end

-- a book as a tree row names it: "Vol. 2" from "The Art of Artefacts Fusion Vol. 2" (its last
-- word with a digit and the word before), else its whole name; a recipe set that is no item, "No book"
function tree_book(book)
    if not ini_sys:section_exist(book) then
        return t("st_almanac_tree_nobook")
    end
    local n = name_of(book)
    return n:match("(%S+%s+%S*%d%S*)%s*$") or n
end

-- a part's or an artifact's count against what's held: "1/4", and its role
local function held(got, n)
    return string.format("%d/%d", got, n), got >= n and "good" or (got == 0 and "warn" or "heading")
end

-- the crafting tree's words, on almanac_trees.layers: { title, sum, leaves, rows = { { label,
-- label_role, sub, unread, nodes }, ... } }; each node gets its name, role ("link", or "dim" under a
-- carried one), status ({ text, role } or nil) and lines, a part each ({ name, count, role }). Uses
-- what the page crafts with (the stashes in range too), as the entry's last block does. nil when
-- nothing makes it
function tree(sec, have)
    local supply = supply_for(have)
    local C = almanac_data.catalog()
    local a = C.artifacts[sec]
    local eager = almanac_trees.eager_now()
    local L = a and almanac_trees.layers(sec, supply, eager, C)
    if not L then
        return nil
    end
    local out = { title = f("st_almanac_tree_title", a.name), leaves = L.leaves, rows = {}, root = L.root }
    local layers = 0
    for _, nodes in ipairs(L.rows) do
        local books, crafts, unread, order = {}, 0, false, {}
        for _, n in ipairs(nodes) do
            local dim = n.state == "under"
            n.name = C.artifacts[n.sec] and C.artifacts[n.sec].name or name_of(n.sec)
            n.role = dim and "dim" or "link"
            if n.state == "carried" then
                n.status = { n.n == 1 and t("st_almanac_tree_carried") or f("st_almanac_tree_carried_n", n.n), "good" }
            elseif n.state == "under" then
                n.status = { t("st_almanac_tree_under"), "dim" }
            elseif n.state == "find" then
                local rest = n.n - n.got
                local s = n.got > 0 and f("st_almanac_tree_find_more", rest)
                    or (rest == 1 and t("st_almanac_tree_find") or f("st_almanac_tree_find_n", rest))
                n.status = { s, "warn" }
            elseif n.state == "craft" and n.got > 0 then
                n.status = { f("st_almanac_tree_partial", n.got, n.n), "heading" }
            end
            -- a carried one's parts aren't needed either
            local spare = dim or n.state == "carried"
            n.lines = {}
            for _, p in ipairs(n.parts) do
                local count, role = held(p.got, p.n)
                n.lines[#n.lines + 1] = { sec = p.sec, name = name_of(p.sec), count = count, role = spare and "dim" or role }
            end
            if n.book then
                if not books[n.book] then
                    books[n.book] = true
                    order[#order + 1] = n.book
                end
                if n.state == "top" or n.state == "craft" then
                    crafts = crafts + n.n - n.got
                end
            end
        end
        local row = { nodes = nodes }
        if #order > 0 then
            layers = layers + 1
            local names = {}
            for _, b in ipairs(order) do
                names[#names + 1] = tree_book(b)
                unread = unread or not almanac_trees.book_known(b)
            end
            row.label, row.label_role = table.concat(names, " / "), unread and "warn" or "heading"
            row.sub = f("st_almanac_tree_crafts", crafts)
            row.unread = unread and t("st_almanac_tree_unread") or nil
        else
            row.label, row.label_role, row.sub = t("st_almanac_tree_zone"), "heading", t("st_almanac_tree_zone_sub")
        end
        out.rows[#out.rows + 1] = row
    end
    local tt = almanac_trees.totals(sec, eager, C)
    local n_arts = 0
    for _, n in pairs(tt.artifacts) do
        n_arts = n_arts + n
    end
    local m, o = part_split(tt.parts)
    out.sum = o > 0 and f("st_almanac_tree_sum_items", tt.crafts, layers, n_arts, m, o)
        or f("st_almanac_tree_sum", tt.crafts, layers, n_arts, m)
    return out
end

-- the header's counts: known of listed, and how many found
function counts(have)
    local g = groups(have)[1]
    local n = 0
    for sec in pairs(almanac_data.catalog().artifacts) do
        if found(sec) then
            n = n + 1
        end
    end
    return g.known, g.total, n
end
